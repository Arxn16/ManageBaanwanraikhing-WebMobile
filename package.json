{
  "name": "manage-banwaenraikhing",
  "version": "2.0.0",
  "description": "ระบบจัดการร้านแว่นตา บ้านแว่นไร่ขิง (เว็บ + server ใช้ภายในร้าน เปิดจากมือถือได้)",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --watch --disable-warning=ExperimentalWarning server/index.js",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/input.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i styles/input.css -o public/css/app.css --watch",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
